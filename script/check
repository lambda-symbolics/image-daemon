#!/bin/sh

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$root"

if [ ! -r "$root/.qlot/setup.lisp" ]; then
  printf '%s\n' 'image-daemon dependencies are missing; run ./script/bootstrap.' >&2
  exit 1
fi

exec sbcl --noinform --non-interactive \
  --load "$root/.qlot/setup.lisp" \
  --eval '(require :asdf)' \
  --eval "(asdf:initialize-source-registry '(:source-registry (:directory #p\"$root/\") :inherit-configuration))" \
  --eval '(asdf:load-asd (truename "image-daemon.asd"))' \
  --eval '(unless (equal (truename ".") (asdf:system-source-directory (asdf:find-system "image-daemon"))) (error "image-daemon source precedence is incorrect"))' \
  --eval '(asdf:test-system "image-daemon")'
