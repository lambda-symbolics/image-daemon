(in-package #:image-daemon/tests)

(-> test-client-termination () t)
(defun test-client-termination ()
  "Distinguish attachment termination causes while preserving legacy return values."
  (dolist (entry '((nil :unexpected-eof)
                   ((:detached) :detached)
                   ((:revoked) :revoked)
                   ((:exit :status 0 :message "done") :application-exit)
                   ((:exit :status 1 :details (:reason "attachment-failure" :stage "replay"))
                    :remote-failure)
                   ((:exit :status 1 :details (:reason "queue-overflow")) :queue-overflow)
                   ((:exit :status "invalid") :decoding-failure)
                   ((:output 17) :decoding-failure)))
    (destructuring-bind (packet kind) entry
      (let* ((input     (make-string-input-stream (if packet (daemon-packet-string packet) "")))
             (stopped-p nil)
             (observed  nil)
             (exit      nil))
        (multiple-value-bind (result termination)
            (daemon-attach-receive input (make-broadcast-stream)
                                   (lambda () (setf stopped-p t))
                                   :exit-function (lambda (value) (setf exit value))
                                   :termination-function
                                   (lambda (value)
                                     (check (not stopped-p) "termination is recorded before cleanup")
                                     (setf observed value)))
          (check (and (null result) stopped-p (eq termination observed)
                      (eq (getf termination :kind) kind))
                 "attachment end ~S is reported as ~S" packet kind)
          (check (eq (not (null exit))
                     (not (null (member kind '(:application-exit :remote-failure :queue-overflow)))))
                 "only valid exit packets invoke the legacy exit callback")))))
  (multiple-value-bind (result termination)
      (daemon-attach-receive (make-string-input-stream (format nil "5~%(:x"))
                             (make-broadcast-stream) (constantly nil))
    (check (and (null result) (eq (getf termination :kind) ':decoding-failure))
           "truncated wire data is not an intentional detach"))
  (let ((stopped-p nil))
    (multiple-value-bind (result termination)
        (daemon-attach-receive
         (make-string-input-stream (daemon-packet-string '(:screen :frame)))
         (make-broadcast-stream) (lambda () (setf stopped-p t))
         :packet-function      (lambda (packet)
                                 (declare (ignore packet))
                                 (error "private-render-payload"))
         :termination-function (lambda (diagnostic)
                                 (declare (ignore diagnostic))
                                 (error "secondary-notification-payload")))
      (check (and (null result) stopped-p
                  (eq (getf termination :kind) ':callback-failure)
                  (getf termination :condition-type)
                  (getf termination :notification-condition-type)
                  (not (search "payload" (write-to-string termination))))
             "rendering failure survives notification failure without printing either payload")))
  (dolist (entry '((nil :unexpected-eof nil)
                   ((:exit :status 7 :message "finished") :application-exit 7)))
    (destructuring-bind (packet kind status) entry
      (let ((closed-p nil))
        (multiple-value-bind (exit termination)
            (daemon-attach-client-run
             (make-string-input-stream (if packet (daemon-packet-string packet) ""))
             :output-stream        (make-broadcast-stream)
             :input-ready-function (constantly nil)
             :close-function       (lambda () (setf closed-p t)))
          (check (and closed-p (eq (getf termination :kind) kind)
                      (eql (getf exit :status) status))
                 "the client runner returns its legacy exit and a distinct termination cause")))))
  (let ((notified-p nil))
    (multiple-value-bind (result termination)
        (daemon-attach-receive
         (make-string-input-stream (daemon-packet-string '(:exit :status 0)))
         (make-broadcast-stream) (constantly nil)
         :termination-function (lambda (diagnostic)
                                 (setf notified-p (eq (getf diagnostic :kind) ':application-exit)))
         :exit-function        (lambda (exit)
                                 (declare (ignore exit))
                                 (check notified-p "terminal cause precedes legacy exit observers")
                                 (error "private-observer-payload")))
      (check (and (null result) (eq (getf termination :kind) ':application-exit)
                  (getf termination :observer-condition-type))
             "a failed legacy observer cannot replace an accepted application exit")))
  (let ((socket (make-instance 'sb-bsd-sockets:inet-socket :type ':stream :protocol ':tcp)))
    (sb-bsd-sockets:socket-close socket)
    (multiple-value-bind (exit termination)
        (daemon-attach-client-run
         (make-string-input-stream (daemon-packet-string '(:exit :status 7)))
         :socket socket :output-stream (make-broadcast-stream)
         :close-function (lambda () (error "duplicate-close-payload")))
      (check (and (eql (getf exit :status) 7)
                  (eq (getf termination :kind) ':application-exit)
                  (getf termination :cleanup-condition-type)
                  (not (search "payload" (write-to-string termination))))
             "closed socket and secondary cleanup errors preserve the confirmed exit")))
  t)
